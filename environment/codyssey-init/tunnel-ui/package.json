{
  "name": "codyssey-tunnel-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/App.tsx --bundle --minify --jsx=automatic --outdir=dist",
    "typecheck": "tsc --noEmit --strict --jsx react-jsx --lib es2022,dom --module esnext --moduleResolution bundler src/App.tsx",
    "test": "node --test test/policy.test.mjs",
    "test:browser": "node --test test/browser.test.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "playwright": "1.61.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
