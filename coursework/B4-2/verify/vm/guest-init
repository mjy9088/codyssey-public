#!/bin/sh
set -eu
export PATH=/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
fatal() { echo "VM-LAB-FAILURE: $*"; poweroff -f; }
trap 'fatal "line=$LINENO exit=$?"' 0
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs -o size=128m,nosuid,nodev tmpfs /tmp
chmod 1777 /tmp
echo "VM-LAB-BEGIN: $(uname -srvmo)"
LAB_OUTPUT_DIR=/tmp/results /lab/tests/run.sh
echo 'VM-LAB-SUCCESS'
trap - 0
poweroff -f
