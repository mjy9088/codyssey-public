#!/bin/busybox sh
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
fatal() { echo "VM-BOOT-FATAL: $*" >&2; exec sh; }
mount -t proc proc /proc || fatal "cannot mount /proc"
mount -t sysfs sysfs /sys || fatal "cannot mount /sys"
mount -t devtmpfs devtmpfs /dev || fatal "cannot mount /dev"
mkdir -p /dev/pts /run
mount -t devpts devpts /dev/pts || fatal "cannot mount /dev/pts"
test -s /www/index.html || fatal "built SPA is missing"
test -d /lib/modules/"$(uname -r)" || fatal "kernel modules do not match"
modprobe virtio_pci || fatal "virtio_pci failed"
modprobe virtio_net || fatal "virtio_net failed"
interface=""
for candidate in /sys/class/net/*; do
  name="${candidate##*/}"
  if [ "$name" != "lo" ]; then interface="$name"; break; fi
done
test -n "$interface" || fatal "no network interface"
ip link set lo up || fatal "cannot enable loopback"
ip link set "$interface" up || fatal "cannot enable network"
ip address add 10.0.2.15/24 dev "$interface" || fatal "cannot assign guest address"
ip route add default via 10.0.2.2 dev "$interface" || fatal "cannot add route"
{
  printf 'kernel='; uname -srvmo
  printf 'machine='; cat /sys/class/dmi/id/product_name 2>/dev/null || printf 'QEMU virtual machine\n'
  printf 'boundary=spa-in-guest firebase-emulator-in-compose\n'
} > /www/__vm-proof.txt || fatal "cannot create proof"
cat /www/__vm-proof.txt
echo "VM-BOOT-READY: Benchbook SPA at http://10.0.2.15:8080"
exec /bin/busybox-extras httpd -f -p 8080 -h /www -c /etc/httpd.conf
